# Moodle URL
MOODLE_URL=https://elearn.apsit.edu.in/moodle/

# --- OPTION 1: Groq (RECOMMENDED - 100% Free, Instant Setup) ---
# Get key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# --- OPTION 2: Gemini API key (FREE) ---
# Get key at: https://aistudio.google.com/app/apikey (key starts with "AIza...")
GEMINI_API_KEY=

# --- OPTION 3: AWS Bedrock (Uses your $200 AWS Promotional Credits) ---
# Enable Claude 3.5 Haiku or Llama 3 in Bedrock console
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0

# --- OPTION 4: OpenRouter API key ---
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto


# --- Bot settings ---
PAUSE_AFTER_ANSWER=1.5
PAUSE_AFTER_NEXT=2.0
AUTO_CLICK_NEXT=true
AUTO_SUBMIT=true