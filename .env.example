# ─────────────────────────────────────────────────────────────
#  Moodle Quiz Bot Environment Configuration
# ─────────────────────────────────────────────────────────────

# Your university's Moodle URL (with trailing slash)
MOODLE_URL=https://elearn.apsit.edu.in/moodle/

# =============================================================
#  AI PROVIDER OPTIONS (Choose at least ONE)
# =============================================================

# --- OPTION 1: Groq (RECOMMENDED - 100% Free, Ultra Fast) ---
# Get key instantly (no credit card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- OPTION 2: Google Gemini (100% Free) ---
# Get key (starts with "AIza..."): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- OPTION 3: AWS Bedrock (Use your $200 AWS Promotional Credits) ---
# Models: anthropic.claude-3-5-haiku-20241022-v1:0, meta.llama3-8b-instruct-v1:0, amazon.nova-micro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0

# --- OPTION 4: OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# =============================================================
#  BOT TIMING & NAVIGATION SETTINGS
# =============================================================
PAUSE_AFTER_ANSWER=1.5
PAUSE_AFTER_NEXT=2.0
AUTO_CLICK_NEXT=true
AUTO_SUBMIT=true

